# dependencies
node_modules/

# Next.js build output (castle-app)
.next/
out/
build/
.vercel/

# env files — never commit secrets, anywhere in the tree
.env
.env.*.local
.env.local
.env.local.example.local

# the local SQLite database is a mutable binary data store, not source —
# data/schema.sql (the template) is tracked, the live .db file is not
data/empire.db
data/empire.db-journal
data/empire.db-wal
data/empire.db-shm

# ad-hoc verification/test scripts created during local debugging sessions
_verify*.mjs
_verify*.json

# stray artifacts not part of the real project (see _quarantine/README if any)
_quarantine/

# Claude Code's own local tool state — not project source
.claude/

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Copy to .env.local (never commit the real file) and fill in from your
# Supabase project's Settings -> API page.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-side only, never exposed to the browser.
# Used by API routes for the task-mutation logic (create/claim/complete).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
